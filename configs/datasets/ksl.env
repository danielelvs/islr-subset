# KSL generic batch config
DATASET="ksl"
DATA_CSV="data/interim/ksl/ksl_mediapipe.csv"
RESULTS_DIR="experiments/ksl_nested_lopo_grid_50"
REPORTS_DIR="reports/ksl_50"

# Article-like MediaPipe protocol
SUBSETS="2nd arcanjo laines 1st all"
IMPUTATIONS="true false"
PROTOCOL="nested_lopo"
# EPOCHS="30"
EPOCHS="50"
PATIENCE="5"
BATCH_SIZE="64"
NUM_WORKERS="0"
LR="0.0001"
WD="0.0001"
DEVICE="cuda"
SEED="42"
MAX_RUNS="none"
SAVE_MODELS="false"
CACHE_PREPROCESSED="false"

# Explicit source schema. Keep these values aligned with DATA_CSV.
PERSON_COL="interpreter"
CATEGORY_COL="sign_id"
VIDEO_COL="video_name"
FRAME_COL="frame_id"
