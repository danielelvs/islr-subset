# LIBRAS-UFOP generic batch config
DATASET="ufop"
DATA_CSV="data/interim/ufop/ufop_mediapipe.csv"
RESULTS_DIR="experiments/ufop_nested_lopo_resume_grid"
REPORTS_DIR="reports/ufop"

SUBSETS="2nd arcanjo laines 1st all"
IMPUTATIONS="true false"
PROTOCOL="nested_lopo"
EPOCHS="30"
PATIENCE="5"
BATCH_SIZE="64"
NUM_WORKERS="0"
LR="0.0001"
WD="0.0001"
DEVICE="cuda"
SEED="42"
MAX_RUNS="none"
SAVE_MODELS="false"
CACHE_PREPROCESSED="false"

PERSON_COL="participant_id"
CATEGORY_COL="sign_id"
# sample_id identifies each segmented sign; sequence_id may group multiple segments.
VIDEO_COL="sample_id"
FRAME_COL="frame_id"
